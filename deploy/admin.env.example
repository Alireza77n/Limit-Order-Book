# Copy this file to deploy/admin.env (gitignored, never committed) and fill
# in real values before starting the `admin` compose service.

# Single shared admin login (see spec: multi-admin/RBAC explicitly deferred).
ADMIN_USERNAME=admin

# Generate with:
#   python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('replace-with-a-real-password', method='pbkdf2:sha256'))"
ADMIN_PASSWORD_HASH=replace-with-generated-hash

# Flask session signing key. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SESSION_SECRET=replace-with-generated-secret
