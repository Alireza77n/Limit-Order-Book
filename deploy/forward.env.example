# Copy to /etc/market-maker-forward.env. Keep this file readable only by root.
# The forward agent passes this environment to the isolated live worker only.
FORWARD_TRADING_ENABLED=0
NOBITEX_API_KEY=replace-with-nobitex-api-key
NOBITEX_SECRET_KEY=replace-with-nobitex-secret-key
# Mazdax (markets ahrm1, roba1, nogh1, zfam1): a key with the read_only and spot permissions only,
# never withdraw or transfer, and this server in its IP list. Leave unset when Mazdax is not traded live.
MAZDAX_API_KEY=replace-with-mazdax-api-key
MAZDAX_SECRET_KEY=replace-with-mazdax-secret
