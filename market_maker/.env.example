# Copy this file to .env (same directory) and fill in real values.
# .env is gitignored and must never be committed.

# Nobitex API token (required to read balances / place orders).
NOBITEX_API_TOKEN=your-nobitex-api-token-here

# MySQL connection used to persist trade logs (save_to_db).
MYSQL_HOST=localhost
MYSQL_USER=your-mysql-username
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=trading_bot

# Telegram notifications (optional, demo mode). Create a bot via @BotFather,
# add it as admin to the target channel, then get the numeric chat id by
# posting once in the channel and calling
# https://api.telegram.org/bot<token>/getUpdates (see reports/telegram-notify.md).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-channel-chat-id-here
