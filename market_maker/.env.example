# Copy this file to .env (same directory) and fill in real values.
# .env is gitignored and must never be committed.

# Nobitex API token (required to read balances / place orders).
NOBITEX_API_TOKEN=your-nobitex-api-token-here

# MySQL connection used to persist trade logs (save_to_db).
MYSQL_HOST=localhost
MYSQL_USER=your-mysql-username
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=trading_bot

# Telegram notifications (optional, demo mode). Create a bot via @BotFather,
# add it as admin to the target channel, then get the numeric chat id by
# posting once in the channel and calling
# https://api.telegram.org/bot<token>/getUpdates (see reports/telegram-notify.md).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-channel-chat-id-here

# Admin panel (admin_app.py / the `admin` Docker service, demo-only).
# ADMIN_USERNAME is plain text. ADMIN_PASSWORD_HASH is NOT your password --
# The local example below uses admin/admin. To choose another password,
# generate its hash with:
#   python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('choose-a-real-password', method='pbkdf2:sha256'))"
# replace each `$` in the generated hash with `$$` for Docker Compose, then
# paste it below. Log in at /admin/ with the plain username and
# the password you hashed (not the hash). Do not reuse these local credentials
# in production; deploy/admin.env should contain a unique password hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2:sha256:1000000$$zJIa0qrinUjVXew5$$7c096d955aaa98980a78de5cd26efc4c4b3411ccf5013268247c792e600e20da
# Optional: fixes the Flask session signing key across restarts (otherwise
# a random one is generated each start, which logs everyone out on restart).
ADMIN_SESSION_SECRET=
