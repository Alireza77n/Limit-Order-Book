# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# macOS
.DS_Store

# Local env / secrets
.env
*.local
deploy/admin.env

# Local analysis notes (never pushed)
/reports/

# Data outputs the bot writes at runtime (market_maker/results/)
*.csv
market_maker/results/*.json
market_maker/results/*.lock
market_maker/results/*.sqlite3
market_maker/results/*.sqlite3-shm
market_maker/results/*.sqlite3-wal
market_maker/results/*_archive*.jsonl
# Admin control-queue runtime state: pending commands, results, audit log.
market_maker/results/control/
!market_maker/results/.gitkeep
docs/
.docker-validation-results*/
.worktrees/

# Local UI-testing scratch: Playwright MCP output and ad-hoc screenshots
# dropped at the repo root. Scoped to the root so real image assets
# committed under docs/ or a future assets/ dir are unaffected.
.playwright-mcp/
/*.png

# Docker Compose's live runtime data (backups, control queue/audit, results,
# state) -- host bind-mount target, never meant to be tracked in git. Never
# committed on the server either; if it ever gets `git add`ed by accident,
# `git reset` it back out (see usage.md's "Recovering from an accidental
# runtime/ commit" section) rather than force-adding it.
/runtime/
